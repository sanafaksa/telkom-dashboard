# Salin ke .env di server, lalu isi nilai yang bertanda "isi".
# Untuk lokal: APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost:8000, CORS_ALLOWED_ORIGINS=*

APP_NAME="Telkom Dashboard API"
APP_ENV=production
APP_KEY=                       # isi: php artisan key:generate --show (sekali saja)
APP_DEBUG=false
APP_URL=https://domain-anda.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database (isi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telkom_dashboard
DB_USERNAME=                   # isi
DB_PASSWORD=                   # isi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# CORS: domain frontend yang boleh memanggil API, pisahkan dengan koma. Jangan pakai * di production.
CORS_ALLOWED_ORIGINS=https://domain-anda.com

# Mail (isi SMTP bila sudah siap; log = hanya ditulis ke laravel.log)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (isi, wajib untuk login)
TURNSTILE_SECRET_KEY=          # isi
