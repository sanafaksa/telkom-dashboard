# Dibaca Vite saat `npm run build` dan ikut masuk ke bundle browser (jangan isi rahasia di sini).
# Salin ke telkom/.env di server sebelum build.

# Base URL API. Deploy satu domain: /api. Jika API di domain lain: https://domain-anda.com/api
VITE_API_BASE_URL=https://domain-anda.com/api
VITE_APP_NAME="Telkom Dashboard"
VITE_TURNSTILE_SITE_KEY=       # isi: site key Cloudflare Turnstile

# Hanya untuk `npm run dev`: tujuan proxy /api lokal.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
