Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan ganggu request ke backend Laravel
    RewriteRule ^api(/|$) - [L]

    # Jangan rewrite file dan folder yang memang tersedia
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React SPA fallback
    RewriteRule ^ index.html [L]
</IfModule>